@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string Active(string a) => string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        try { var t = localStorage.getItem('dc-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="dc-nav">
        <div class="dc-wrap dc-nav-inner">
            <a class="dc-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/1.png" alt="Di-Core Labs logo" />
                <div>Di-Core <span>Labs</span></div>
            </a>

            <button class="dc-burger" id="dcBurger" type="button" aria-label="Toggle navigation" aria-expanded="false">
                <svg class="dc-ico" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
            </button>

            <nav class="dc-nav-links" id="dcNav">
                <a class="dc-link @Active("Index")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="dc-link @Active("Services")" asp-controller="Home" asp-action="Services">Services</a>
                <a class="dc-link @Active("Team")" asp-controller="Home" asp-action="Team">Team</a>
                <a class="dc-link @Active("Contact")" asp-controller="Home" asp-action="Contact">Contact</a>
                <a class="dc-link @Active("trust")" asp-controller="Home" asp-action="trust">Coming Soon</a>
                
                <button type="button" class="dc-theme-btn" id="dcTheme" aria-label="Toggle light and dark theme">
                    <svg class="dc-ico sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="dc-ico moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>

                <a class="dc-btn dc-btn-primary dc-btn-sm" asp-controller="Home" asp-action="Contact">
                    Let's Talk
                    <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="dc-footer">
        <div class="dc-wrap dc-footer-inner">
            <a class="dc-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/2.png" alt="Di-Core Labs logo" />
                <div>Di-Core <span>Labs</span></div>
            </a>
            <p>&copy; 2026 Di-Core Labs &mdash; Junior Dube &amp; Kananelo Motuba</p>
            <div class="dc-footer-social">
                <a href="https://www.facebook.com/people/Dual-Core-Labs/pfbid0Ndb2g8dTknkqdDXf9mNJoDw3XzLxd6dLvqS5ERs3wwUicFg7qLvLyKwhqD8vt9ELl/" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg class="dc-ico" viewBox="0 0 24 24"><path d="M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z" /></svg>
                </a>
                <a href="https://www.instagram.com/di.corelabs" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg class="dc-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></svg>
                </a>
                <a href="https://www.linkedin.com/company/dicorelabs" target="_blank" rel="noopener" aria-label="LinkedIn">
                    <svg class="dc-ico" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
