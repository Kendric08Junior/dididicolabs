@{
    ViewData["Title"] = "Our Services | Di-Core Labs";
}

<section class="dc-page-hero">
    <div class="dc-wrap">
        <span class="dc-eyebrow">What We Do</span>
        <h1 class="dc-page-title">Our Services</h1>
        <p class="dc-page-sub">From simple landing pages to complex business systems &mdash; we cover it all.</p>
    </div>
</section>

<section class="dc-section">
    <div class="dc-wrap">
        <div class="dc-svc-grid">
            <div class="dc-svc-card">
                <svg class="dc-svc-icon" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
                <h3>Website Development</h3>
                <p>We build custom websites from scratch &mdash; clean, fast, mobile-ready and tailored specifically to your business. No templates, no shortcuts. Just quality work that represents your brand properly online.</p>
                <a asp-controller="Home" asp-action="Contact" aria-label="Ask about website development">
                    <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
            </div>
            <div class="dc-svc-card">
                <svg class="dc-svc-icon" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
                <h3>System Development</h3>
                <p>Need something more than a website? We build full business systems &mdash; databases, admin dashboards, booking systems, inventory management, and custom automation tools that save you time and money.</p>
                <a asp-controller="Home" asp-action="Contact" aria-label="Ask about system development">
                    <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
            </div>
            <div class="dc-svc-card">
                <svg class="dc-svc-icon" viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /><path d="M2 2l7.586 7.586" /><circle cx="11" cy="11" r="2" /></svg>
                <h3>UI/UX Design</h3>
                <p>Great design is more than looking good &mdash; it's about making things easy to use. We design interfaces that guide your users naturally, keep them engaged, and turn visitors into customers.</p>
                <a asp-controller="Home" asp-action="Contact" aria-label="Ask about UI/UX design">
                    <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
            </div>
            <div class="dc-svc-card">
                <svg class="dc-svc-icon" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                <h3>Maintenance &amp; Support</h3>
                <p>We don't disappear after launch. We offer ongoing maintenance, updates, bug fixes and support so your website or system keeps running smoothly long after it goes live.</p>
                <a asp-controller="Home" asp-action="Contact" aria-label="Ask about maintenance and support">
                    <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="dc-cta">
    <div class="dc-wrap">
        <h2>Have a project in mind?</h2>
        <p>Let's talk about what you need &mdash; no pressure, no obligation.</p>
        <a asp-controller="Home" asp-action="Contact" class="dc-btn dc-btn-primary">
            Contact Us
            <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>
    </div>
</section>
