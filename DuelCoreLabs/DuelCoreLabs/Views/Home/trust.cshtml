@{
    ViewData["Title"] = "Coming soon | Di-Core Labs";
}

<div class="cs">
  <div class="dc-wrap cs-wrap">

    <span class="dc-eyebrow">Coming Soon</span>
    <h1 class="cs-h1">Two new things are coming soon.</h1>
    <p class="cs-lede">We build websites and business systems for local businesses. Next, we're adding IT support and Trust, a local marketplace in your pocket.</p>

    <div class="cs-grid">

      <!-- IT SUPPORT -->
      <section class="cs-panel cs-it" aria-labelledby="it-title">
        <span class="cs-status">Coming soon</span>
        <h2 id="it-title">IT support for small businesses</h2>
        <p class="cs-it-tag">Hands-on help so your business tech just works.</p>
        <p>
          Most small businesses don't have an IT department, and a dead router or a locked-out
          email account can stop the whole day. We'll be the people you call: friendly,
          quick to respond, and no jargon.
        </p>

        <h3>What we'll help with</h3>
        <ul class="cs-it-list">
          <li><strong>Network &amp; wifi:</strong> router setup, coverage fixes, and a secure network for staff and guests</li>
          <li><strong>Computers &amp; devices:</strong> laptops, desktops, printers, Windows and Mac fixes and setup</li>
          <li><strong>Email &amp; cloud:</strong> business email setup, file sharing and automatic backups</li>
          <li><strong>Security:</strong> antivirus, virus and malware cleanup, and safer passwords</li>
          <li><strong>Everyday support:</strong> new staff setup, software installs and quick questions</li>
        </ul>

        <h3>How it will work</h3>
        <ol class="cs-it-steps">
          <li><strong>Tell us the problem.</strong> Send a message and describe what's going wrong.</li>
          <li><strong>We sort it out.</strong> We fix it remotely where we can, or come to you when we need to.</li>
          <li><strong>Stay covered.</strong> Pick a monthly plan so help is there before small issues become big ones.</li>
        </ol>

        <h3>Monthly support plans</h3>
        <p>
          A simple monthly plan keeps your equipment checked, backed up and up to date, with
          a direct line to us whenever something breaks. We'll share the details when we launch.
        </p>

        <p class="cs-it-foot">Need help now, or want to know when plans open? Get in touch.</p>
        <a class="dc-btn dc-btn-primary" asp-controller="Home" asp-action="Contact">
          Ask about IT support
          <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>
      </section>

      <!-- TRUST -->
      <section class="cs-panel cs-trust" aria-labelledby="trust-title">
        <span class="cs-status">Coming soon</span>

        <div class="cs-wordmark" id="trust-title">
          <svg viewBox="0 0 64 64" role="img" aria-label="Checkmark badge">
            <circle cx="32" cy="32" r="30" fill="#0F2A43" />
            <path d="M18 33l9 9 19-21" fill="none" stroke="#F5B700" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Trust</span>
        </div>

        <p class="cs-trust-tag">An app where you can buy and sell things in your own community.</p>
        <p>
          Trust is built for people who would rather deal with real neighbours than strangers.
          List what you no longer need, find what you're looking for close to home, and deal
          with people you can actually trust.
        </p>

        <h3>How it will work</h3>
        <ol class="cs-steps">
          <li><strong>List it.</strong> Add photos, a price and a short description in under a minute.</li>
          <li><strong>Get found.</strong> People in your area see your listing and message you in the app.</li>
          <li><strong>Make the deal.</strong> Agree on a price and arrange a safe handover.</li>
        </ol>

        <h3>What you'll get</h3>
        <ul class="cs-feats">
          <li>Buy and sell with people in your own community</li>
          <li>Profiles and ratings so you know who you're dealing with</li>
          <li>Built-in chat, so you don't have to share your phone number</li>
          <li>Search and filters by category, price and area</li>
          <li>Safety tips for meet-ups and handovers</li>
          <li>Free to browse and to list your items</li>
        </ul>

        <p class="cs-trust-foot">Want to be one of the first to try it? Tell us and we'll let you know the day it launches.</p>
        <a class="cs-btn-dark" asp-controller="Home" asp-action="Contact">Get early access</a>
      </section>

    </div>

    <section class="cs-contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Want to hear when we launch?</h2>
      <p>Send us a message or follow us, and we'll tell you as soon as IT support and Trust are ready.</p>
      <a class="dc-btn dc-btn-primary" asp-controller="Home" asp-action="Contact">
        Contact us
        <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
      </a>

      <div class="dc-social-grid">
        <a href="https://www.facebook.com/people/Dual-Core-Labs/pfbid0Ndb2g8dTknkqdDXf9mNJoDw3XzLxd6dLvqS5ERs3wwUicFg7qLvLyKwhqD8vt9ELl/" target="_blank" rel="noopener" class="dc-social-card">
          <svg class="dc-ico" viewBox="0 0 24 24"><path d="M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z" /></svg>
          <div>
            <strong>Facebook</strong>
            <span>Di Core Labs &middot; Follow our page</span>
          </div>
          <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>

        <a href="https://www.instagram.com/di.corelabs" target="_blank" rel="noopener" class="dc-social-card">
          <svg class="dc-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></svg>
          <div>
            <strong>Instagram</strong>
            <span>@@di.corelabs &middot; See our latest work</span>
          </div>
          <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>

        <a href="https://www.linkedin.com/company/dicorelabs" target="_blank" rel="noopener" class="dc-social-card">
          <svg class="dc-ico" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
          <div>
            <strong>LinkedIn</strong>
            <span>Di Core Labs &middot; Connect with us</span>
          </div>
          <svg class="dc-arr" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>
      </div>
    </section>

  </div>
</div>

@section Scripts {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* Everything is scoped under .cs so it can't affect the rest of the site */
  .cs { --taxi: #F5B700; --on-taxi: #0F2A43; --display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif; font-family: "Public Sans", system-ui, "Segoe UI", sans-serif; }
  .cs-wrap { padding-top: 3.5rem; padding-bottom: 4rem; }
  .cs-h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2.25rem, 7vw, 4.25rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 1rem; max-width: 14em; }
  .cs-lede { color: var(--muted); max-width: 36rem; margin: 0 0 2.5rem; font-size: 1.1rem; }

  .cs-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; align-items: stretch; }
  @@media (min-width: 52rem) { .cs-grid { grid-template-columns: 1fr 1.15fr; } }

  .cs-panel { border-radius: 1.25rem; padding: 2rem 1.75rem; }
  .cs-panel h2 { font-family: var(--display); font-weight: 700; font-size: 1.75rem; line-height: 1.15; margin: 1rem 0 .75rem; }
  .cs-panel h3 { font-family: var(--display); font-weight: 700; font-size: 1.2rem; margin: 1.5rem 0 .6rem; }
  .cs-panel p { margin: 0 0 1rem; }
  .cs-status { display: inline-block; font-weight: 600; font-size: .9rem; padding: .2rem .75rem; border-radius: 999px; }

  .cs-it { background: var(--card); border: 1px solid var(--line); }
  .cs-it .cs-status { background: var(--bg); border: 1px solid var(--line); }
  .cs-it-tag { font-size: 1.2rem; font-weight: 600; }
  .cs-it p { color: var(--muted); }
  .cs-it .cs-it-tag { color: var(--fg); }
  .cs-it-list, .cs-it-steps { margin: 0; padding-left: 1.3rem; color: var(--muted); }
  .cs-it-list li, .cs-it-steps li { margin: .45rem 0; }
  .cs-it-list strong, .cs-it-steps strong { color: var(--fg); }
  .cs-it-foot { margin: 1.5rem 0 1rem !important; font-weight: 500; color: var(--fg) !important; }

  .cs-trust { background: var(--taxi); color: var(--on-taxi); }
  .cs-trust .cs-status { background: var(--on-taxi); color: var(--taxi); }
  .cs-wordmark { display: flex; align-items: center; gap: .75rem; margin: 1.25rem 0 .75rem; }
  .cs-wordmark svg { width: 3.25rem; height: 3.25rem; flex: none; }
  .cs-wordmark span { font-family: var(--display); font-weight: 800; font-size: clamp(3rem, 9vw, 5rem); line-height: 1; letter-spacing: -0.03em; }
  .cs-trust-tag { font-size: 1.2rem; font-weight: 600; max-width: 28rem; }
  .cs-steps, .cs-feats { margin: 0; padding-left: 1.3rem; }
  .cs-steps li, .cs-feats li { margin: .4rem 0; }
  .cs-trust-foot { margin: 1.5rem 0 1rem !important; font-weight: 500; }
  .cs-btn-dark { display: inline-block; font-weight: 600; padding: .8rem 1.4rem; border-radius: .75rem; background: var(--on-taxi); color: var(--taxi); text-decoration: none; }
  .cs-btn-dark:hover { opacity: .9; }

  .cs-contact { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.75rem; }
  .cs-contact h2 { font-family: var(--display); font-size: 1.5rem; margin: 0 0 .5rem; }
  .cs-contact > p { color: var(--muted); margin: 0 0 1.25rem; max-width: 34rem; }
  .cs .dc-social-grid { margin-top: 1.75rem; }
</style>
}